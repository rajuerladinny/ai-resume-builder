# "mock" needs no LLM: the match score and keyword analysis work, and the
# resume comes back unchanged.
LLM_PROVIDER=mock

# For real rewriting, set LLM_PROVIDER=openai and point at any
# OpenAI-compatible endpoint. Example below is a local Ollama server.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=none
# LLM_MODEL=<model name as your provider lists it>

# Per visitor, per hour.
ANALYZE_LIMIT=60
TAILOR_LIMIT=10
EXTRACT_LIMIT=120

CORS_ORIGINS=http://localhost:5173
# Set to 1 only when the app sits behind a reverse proxy you control.
# TRUST_PROXY=1
